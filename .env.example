# Copy this file to .env for local development. .env is git-ignored —
# never commit real secrets. In AWS, these same variable names are
# injected by ECS from Secrets Manager (see terraform/ecs.tf); nothing
# here is a real credential.

FLASK_ENV=development

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=39b309402afa2c832f46f3e8d24c1fd2f2cc2a07db0fa901a43d2fb25e78e99c

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://notes:notes@localhost:5432/notes

FORCE_HTTPS_COOKIES=false
PORT=5000
